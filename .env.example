##### MQTT Broker credentials
MQTT_HOST=my-mqtt-broker.local
MQTT_PORT=1883
MQTT_SSL=false
MQTT_USERNAME=my-mqtt-username
MQTT_PASSWORD=my-mqtt-password

##### Mappings
#
# A mapping defines how to get a value out of an MQTT message and where to write it in InfluxDB.
# You can define as many as you like: every variable starts with MAPPING_X_, where X is a number
# starting at 0.
#
# Available variables per mapping:
#
# - MAPPING_X_TOPIC: the MQTT topic to subscribe to. Leave it out for a virtual mapping, which
#   calculates its value from other mappings instead of a topic (see the end of this section)
# - MAPPING_X_MEASUREMENT: the name of the InfluxDB measurement to write to
# - MAPPING_X_FIELD: the name of the InfluxDB field to write to
# - MAPPING_X_TYPE: the data type of the field: integer, float, string or boolean
# - MAPPING_X_MEASUREMENT_POSITIVE / _NEGATIVE: measurement per sign, instead of MEASUREMENT
# - MAPPING_X_FIELD_POSITIVE / _NEGATIVE: field per sign, instead of FIELD
# - MAPPING_X_MIN / _MAX: ignore values outside this range (optional)
# - MAPPING_X_NULL_TO_ZERO: write 0 instead of ignoring a missing value (optional)
# - MAPPING_X_JSON_KEY: the key in a JSON payload to read the value from (optional)
# - MAPPING_X_JSON_PATH: the JSONPath in a JSON payload to read the value from (optional)
# - MAPPING_X_JSON_FORMULA: a formula to calculate the value from a JSON payload (optional)
# - MAPPING_X_FORMULA: a formula to calculate the value. On a mapping with a topic it transforms
#   the message via {value}; on a virtual mapping it references other mappings by name
# - MAPPING_X_NAME: the alias other formulas use to reference this mapping, e.g. {washer}. Only
#   needed on a mapping that a formula references. Lowercase letters, digits and underscores
#   only, and it must not start with a digit (optional)
# - MAPPING_X_MAX_AGE: how many seconds this value stays usable in a formula, after which it
#   counts as unknown instead of stale. Requires MAPPING_X_NAME (optional)
#
# JSONPath (the `$.` notation): https://goessner.net/articles/JsonPath/
# Formula operators and functions: https://github.com/rubysolo/dentaku#built-in-operators-and-functions

# The simplest mapping: read the message, convert it, write it. MIN and MAX drop implausible
# readings, so a spike of 99999 W never reaches InfluxDB.
MAPPING_0_TOPIC=senec/0/ENERGY/GUI_INVERTER_POWER
MAPPING_0_MEASUREMENT=PV
MAPPING_0_FIELD=inverter_power
MAPPING_0_TYPE=integer
MAPPING_0_MIN=5
MAPPING_0_MAX=15000

# NAME makes this mapping referenceable from a formula, see the virtual mapping below.
MAPPING_1_TOPIC=senec/0/ENERGY/GUI_HOUSE_POW
MAPPING_1_MEASUREMENT=PV
MAPPING_1_FIELD=house_power
MAPPING_1_TYPE=integer
MAPPING_1_NAME=house_power

# A value that can be positive or negative, split into two fields by its sign. Grid power is
# import when positive and export when negative, and each direction gets its own field.
MAPPING_2_TOPIC=senec/0/ENERGY/GUI_GRID_POW
MAPPING_2_MEASUREMENT_POSITIVE=PV
MAPPING_2_MEASUREMENT_NEGATIVE=PV
MAPPING_2_FIELD_POSITIVE=grid_import_power
MAPPING_2_FIELD_NEGATIVE=grid_export_power
MAPPING_2_TYPE=integer

# The inverter's export limit in percent. TYPE=float keeps the decimals, while TYPE=integer
# would round them away.
MAPPING_3_TOPIC=senec/0/PV1/POWER_RATIO
MAPPING_3_MEASUREMENT=PV
MAPPING_3_FIELD=grid_export_limit
MAPPING_3_TYPE=float

# The same split by sign as above, here for the battery: charging is positive, discharging is
# negative. Each direction ends up in its own field, both always written.
MAPPING_4_TOPIC=senec/0/ENERGY/GUI_BAT_DATA_POWER
MAPPING_4_MEASUREMENT_POSITIVE=PV
MAPPING_4_MEASUREMENT_NEGATIVE=PV
MAPPING_4_FIELD_POSITIVE=battery_charging_power
MAPPING_4_FIELD_NEGATIVE=battery_discharging_power
MAPPING_4_TYPE=integer

# The battery state of charge in percent.
MAPPING_5_TOPIC=senec/0/ENERGY/GUI_BAT_DATA_FUEL_CHARGE
MAPPING_5_MEASUREMENT=PV
MAPPING_5_FIELD=battery_soc
MAPPING_5_TYPE=float

# The wallbox, named so the virtual mapping at the end can subtract it. A NAME may differ from
# the field name, but here they are the same on purpose - it keeps formulas readable.
# MAX_AGE stops formulas from using this value once it is older than 300 seconds, so a wallbox
# that goes offline leaves a gap instead of a wrong base_load. Raise it if your wallbox reports
# less often than that.
MAPPING_6_TOPIC=senec/0/WALLBOX/APPARENT_CHARGING_POWER/0
MAPPING_6_MEASUREMENT=PV
MAPPING_6_FIELD=wallbox_power
MAPPING_6_TYPE=integer
MAPPING_6_NAME=wallbox_power
MAPPING_6_MAX_AGE=300

# A sensor from a different vendor, writing to its own measurement instead of PV. Mappings are
# independent of each other, so any topic can go anywhere.
MAPPING_7_TOPIC=somewhere/HEATPUMP/POWER
MAPPING_7_MEASUREMENT=HEATPUMP
MAPPING_7_FIELD=power
MAPPING_7_TYPE=integer
MAPPING_7_NAME=heatpump_power

# A temperature, which is not power at all - any numeric sensor works the same way.
MAPPING_8_TOPIC=senec/0/TEMPMEASURE/CASE_TEMP
MAPPING_8_MEASUREMENT=PV
MAPPING_8_FIELD=case_temp
MAPPING_8_TYPE=float

# A text value. TYPE=string writes the message as it arrives, without any conversion.
MAPPING_9_TOPIC=senec/0/ENERGY/STAT_STATE_Text
MAPPING_9_MEASUREMENT=PV
MAPPING_9_FIELD=system_status
MAPPING_9_TYPE=string

# A flag. TYPE=boolean writes true for "true", "ok", "yes", "on" and "1", and false for anything
# else. An empty message writes nothing at all, for any mapping.
MAPPING_10_TOPIC=senec/0/ENERGY/STAT_STATE_Ok
MAPPING_10_MEASUREMENT=PV
MAPPING_10_FIELD=system_status_ok
MAPPING_10_TYPE=boolean

# Reading one value out of a JSON payload, e.g. {"power": 1234, "temperature": 42.5}.
# JSON_KEY picks a single key from the top level of the message.
MAPPING_11_TOPIC=my-heatpump/status
MAPPING_11_JSON_KEY=power
MAPPING_11_MEASUREMENT=HEATPUMP
MAPPING_11_FIELD=power_json
MAPPING_11_TYPE=integer

# Reading a nested value via JSONPath, here the third element of an array in {"ccp": [1,2,42,3]}.
# NULL_TO_ZERO writes 0 when the value is null, instead of skipping the message.
# JSONPath syntax: https://goessner.net/articles/JsonPath/
MAPPING_12_TOPIC=go-e/ATTR
MAPPING_12_JSON_PATH=$.ccp[2]
MAPPING_12_MEASUREMENT=WALLBOX
MAPPING_12_FIELD=power_json
MAPPING_12_TYPE=float
MAPPING_12_NULL_TO_ZERO=true

# Calculating from several keys of the same payload, e.g. {"voltage": 230, "current": 5.2}.
# The curly braces reference a key or a JSONPath of that payload, not another mapping.
# Operators and functions: https://github.com/rubysolo/dentaku#built-in-operators-and-functions
MAPPING_13_TOPIC=my-meter/electrical
MAPPING_13_JSON_FORMULA="{voltage} * {current}"
MAPPING_13_MEASUREMENT=METER
MAPPING_13_FIELD=apparent_power
MAPPING_13_TYPE=float

# Transforming a plain (non-JSON) message, here from kW to W. On a mapping with a topic, {value}
# is the message itself - the name of another mapping cannot be used here.
MAPPING_14_TOPIC=my-meter/power-kw
MAPPING_14_MEASUREMENT=METER
MAPPING_14_FIELD=power
MAPPING_14_TYPE=float
MAPPING_14_FORMULA="{value} * 1000"

# A virtual mapping: no topic of its own, its value is calculated from other mappings by their
# MAPPING_X_NAME. This one subtracts the two big consumers from the house power, to see what the
# rest of the household uses. It is recalculated whenever one of the referenced values arrives,
# and written like any other mapping. (Only correct if your house power includes those two.)
MAPPING_15_MEASUREMENT=Household
MAPPING_15_FIELD=base_load
MAPPING_15_TYPE=integer
MAPPING_15_FORMULA="{house_power} - {wallbox_power} - {heatpump_power}"

# More about virtual mappings:
#
# - Reference a mapping by its MAPPING_X_NAME, never by its number. The name is independent of
#   the index on purpose: if your .env is generated by a tool (e.g. HELIOS), adding a sensor
#   shifts every following index, while the name keeps pointing at the right mapping.
# - A formula referencing a name that no mapping defines is refused at startup, so a typo cannot
#   be mistaken for a value that has not arrived yet.
# - You can chain them, i.e. reference a virtual mapping from another virtual mapping, as long as
#   the referenced one has a MAPPING_X_NAME too. The order you write them in does not matter, and
#   the whole chain is calculated from a single message. Only a formula that leads back to itself
#   is refused, because it has no value to start from.
# - While a referenced value is still unknown, the virtual mapping is skipped. With
#   MAPPING_X_NULL_TO_ZERO=true it writes 0 instead - but that 0 is a real value, written to
#   InfluxDB and used by every formula referencing it, so don't combine it with MAX_AGE.
#
# If a sensor goes offline, its last value would otherwise be reused forever, silently producing
# numbers calculated from outdated data. MAPPING_X_MAX_AGE prevents that: once the last value is
# older than that many seconds, it counts as unknown and the virtual mapping stops being written,
# leaving a visible gap instead of a wrong line. It belongs on the source mapping, as shown on
# the wallbox above.
#
# This carries through a whole chain: a calculated value expires as soon as the first value it
# was calculated from expires, so the mappings in between need no MAX_AGE of their own.
#
# Whenever a virtual mapping cannot be calculated, one warning names exactly which references are
# missing and why, e.g.:
#
#   Formula for base_load could not be evaluated
#   (wallbox_power [senec/0/WALLBOX/APPARENT_CHARGING_POWER/0]: last received 145s ago, exceeds MAX_AGE of 300s)
#
# Formulas can also use comparisons (==, !=, >, <, >=, <=) and IF(), including across mappings.
# As with arithmetic, the result stays unresolved as long as any referenced mapping is missing
# or outdated - a comparison never treats "unknown" as a real value to compare against:
#
#   MAPPING_16_MEASUREMENT=Household
#   MAPPING_16_FIELD=wallbox_power_when_different
#   MAPPING_16_TYPE=integer
#   MAPPING_16_FORMULA="IF({wallbox_power} != {heatpump_power}, {wallbox_power}, 0)"
#
# "never received" means no message arrived yet (e.g. right after a restart) and has nothing to
# do with MAX_AGE. The warning is logged once per situation, not once per message, so an offline
# sensor does not flood the log. It appears again when the situation changes.

##### InfluxDB credentials
INFLUX_HOST=localhost
INFLUX_SCHEMA=http
INFLUX_PORT=8086
INFLUX_TOKEN=my-token
INFLUX_ORG=my-org
INFLUX_BUCKET=my-bucket
